# ─────────────────────────────────────────────────────────────────
# ALEX COMMAND HUB — API KEYS
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────────

# NOTION
# Get from: https://www.notion.so/my-integrations → New Integration
# Then share your "Personal Task List" database with the integration
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=25dbaf66f0f642d2a788bcf816fffd08

# GOOGLE (Gmail + Calendar)
# Get from: https://console.cloud.google.com
# 1. Create a project → Enable Gmail API + Google Calendar API
# 2. Credentials → Create OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:3000 to Authorized redirect URIs
# 4. Download the client secret JSON and copy values below
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# To get your refresh token, run: npm run get-token (after filling in client ID/secret)

# ASANA
# Get from: https://app.asana.com/0/my-apps → New Access Token
ASANA_ACCESS_TOKEN=x/xxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASANA_WORKSPACE_GID=56134264439760
ASANA_USER_GID=38997388328040

# APP
NEXT_PUBLIC_APP_NAME=Alex Command Hub
